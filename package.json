{
  "name": "qirvexa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "cf:types": "wrangler types",
    "format": "prettier --ignore-path .gitignore --write src worker qa/*.cjs *.json *.jsonc *.ts *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --ignore-path .gitignore --check src worker qa/*.cjs *.json *.jsonc *.ts *.html *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
